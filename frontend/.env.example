# Google Maps Configuration
# Get a key from Google Cloud Console with Maps JavaScript API and Places API (New) enabled
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Base URL
VITE_API_URL=http://localhost:5001/api

# Clerk Authentication (use the publishable key matching backend Clerk keys)
VITE_CLERK_PUBLISHABLE_KEY=

# Local-only demo profiles; keep false for production
VITE_DEMO_AUTH_ENABLED=false
