# Server & Database Configuration
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/disaster_management
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173
# Replace development origins with the deployed HTTPS frontend origin in production.

# Clerk Authentication (use the same Clerk application in frontend and backend;
# configure live keys for NODE_ENV=production)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Local-only demo access; must remain false in production
DEMO_AUTH_ENABLED=false
# Promote verified users by assigning role/rescueTeamId in the User collection.

# MOSDAC (ISRO) Weather Data Integration
# Register at: https://mosdac.gov.in/internal/registration
# Documentation: https://mosdac.gov.in/downloadapi-manual
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password
MOSDAC_DATASET_ID=your_mosdac_dataset_id

# Google Places API (New) — Server-side Key for Emergency Facilities
# Requires "Places API (New)" enabled in Google Cloud Console
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# OpenRouter AI Chatbot Integration
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash
